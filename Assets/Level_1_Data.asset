  m_Script: {fileID: 11500000, guid: 148c8634925945a47a2f3626956d2656, type: 3}
  m_Name: Level_1_Data
  m_EditorClassIdentifier: 
  questions:
  - questionText: "\u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0434\u043E\u0440\u043E\u0433\u0443?"
    answers:
    - "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C"
    - "\u041F\u043E\u0431\u0435\u0436\u0430\u0442\u044C"
    - "\u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432 \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
    - "\u0417\u0430\u043A\u0440\u0438\u0447\u0430\u0442\u044C"
    correctAnswerIndex: 0
  - questionText: "\u0412 \u043A\u0430\u043A\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C?"
    answers:
    - "\u041D\u0430\u043F\u0440\u0430\u0432\u043E"
    - "\u041D\u0430\u043B\u0435\u0432\u043E"
    - "\u0412\u0432\u0435\u0440\u0445"
    - "\u041D\u0430\u0437\u0430\u0434"
    correctAnswerIndex: 1
  - questionText: "\u041A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u043F\u0440\u043E\u0435\u0437\u0436\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C?"
    answers:
    - "\u0411\u0435\u0433\u043E\u043C"
    - "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C \u0448\u0430\u0433\u043E\u043C"
    - "\u041F\u0440\u044B\u0436\u043A\u0430\u043C\u0438"
    - "\u0421 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438"
    correctAnswerIndex: 1
